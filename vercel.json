{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/doctor/:id/reviews", "destination": "/doctor/[id]/reviews" },
    { "source": "/doctor/:id", "destination": "/doctor/[id]" },
    { "source": "/hospital/:id", "destination": "/hospital/[id]" },
    { "source": "/booking/reschedule/:id", "destination": "/booking/reschedule/[id]" },
    { "source": "/booking/view/:id", "destination": "/booking/view/[id]" },
    { "source": "/booking/:id", "destination": "/booking/[id]" },
    { "source": "/token/:id", "destination": "/token/[id]" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
