{
  "expo": {
    "name": "MedQ+",
    "slug": "medreachplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": ["medqplus", "medreachplus"],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/logo/new/app-icon.png",
    "splash": {
      "image": "./assets/logo/new/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#0891B2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medreachplus",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow MedQ+ to convert your speech to text so you can search by voice.",
        "NSMicrophoneUsageDescription": "Allow MedQ+ to use the microphone for voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/new/adoptive-icon.png",
        "backgroundColor": "#0891B2"
      },
      "package": "com.medreachplus",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCA6RhUmhvgT_Iu2iLO4lyVxPie9YH56lU"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo/new/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow MedQ+ to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow MedQ+ to convert your speech to text so you can search by voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.591757878637-phtrosqel0mmskv4aag38cnpa6lfbgje"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fdf1375-e41d-409e-89cf-dcc2ad0ea0e4"
      }
    },
    "owner": "medqplus"
  }
}
