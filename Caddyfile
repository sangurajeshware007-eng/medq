# Caddy config for serving the Expo static web export on Railway.
# Mirrors vercel.json: clean URLs, dynamic-route rewrites to the exported
# [id].html artifacts, immutable caching for hashed bundles.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"

	# ── Dynamic routes → exported [id].html files ─────────────────────────
	# Each matcher requires that no static page exists for the path first
	# (e.g. /doctor/queue.html must win over the /doctor/[id] rewrite).
	@doctorReviews {
		path_regexp ^/doctor/[^/]+/reviews/?$
	}
	rewrite @doctorReviews "/doctor/[id]/reviews.html"

	@doctor {
		path_regexp ^/doctor/[^/]+/?$
		not file {path}.html
	}
	rewrite @doctor "/doctor/[id].html"

	@patientHistory {
		path_regexp ^/doctor/patient/[^/]+/?$
	}
	rewrite @patientHistory "/doctor/patient/[id].html"

	@hospital {
		path_regexp ^/hospital/[^/]+/?$
		not file {path}.html
	}
	rewrite @hospital "/hospital/[id].html"

	@bookingReschedule {
		path_regexp ^/booking/reschedule/[^/]+/?$
	}
	rewrite @bookingReschedule "/booking/reschedule/[id].html"

	@bookingView {
		path_regexp ^/booking/view/[^/]+/?$
	}
	rewrite @bookingView "/booking/view/[id].html"

	@booking {
		path_regexp ^/booking/[^/]+/?$
		not file {path}.html
		not path /booking/reschedule/* /booking/view/*
	}
	rewrite @booking "/booking/[id].html"

	@token {
		path_regexp ^/token/[^/]+/?$
	}
	rewrite @token "/token/[id].html"

	# ── Clean URLs (/search → /search.html) + 404 fallback ────────────────
	try_files {path} {path}.html {path}/index.html /+not-found.html

	file_server
}

# build-stamp: prod-web-v2
