{
  "name": "MedReachPlus",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cp .env.local .env 2>/dev/null; expo start",
    "start:local": "cp .env.local .env && expo start",
    "start:qa": "cp .env.qa .env && expo start",
    "start:production": "cp .env.production .env && expo start",
    "android": "cp .env.local .env 2>/dev/null; expo start --android",
    "android:qa": "cp .env.qa .env && expo start --android",
    "android:prod": "cp .env.production .env && expo start --android",
    "ios": "cp .env.local .env 2>/dev/null; expo start --ios",
    "ios:build": "cp .env.local .env 2>/dev/null; expo run:ios",
    "ios:qa": "cp .env.qa .env && expo start --ios",
    "ios:prod": "cp .env.production .env && expo start --ios",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.17",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.575.0",
    "react": "19.1.0",
    "react-hook-form": "^7.56.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@react-native-community/cli": "^20.1.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-test-renderer": "19.1.0"
  }
}
